          "plaintex",
          "tex"
        ],
        "path": "./latex/latex.json"
      },
      {
        "language": [
          "plaintex",
          "tex"
        ],
        "path": "./latex/latex-snippets.json"
      },
      {
        "language": [
          "plaintex",
          "tex"
        ],
        "path": "./latex/vscode-latex-snippets.json"
      },
      {
        "language": [
          "plaintex",
          "tex"
        ],
        "path": "./latex/mylatex_snippets.json"
